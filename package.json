{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ncc build src/index.ts --source-map --license licenses.txt",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate": "pnpm generate:docs && pnpm generate:inputs && pnpm generate:unicode-regex && pnpm format",
    "generate:docs": "gha-docgen --style table",
    "generate:inputs": "tsx ./scripts/generate-inputs.ts",
    "generate:unicode-regex": "tsx ./scripts/generate-unicode-regex.ts",
    "lint": "oxlint --max-warnings=0",
    "prepare": "lefthook install",
    "release": "semantic-release",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.0.0",
    "parjs": "^1.3.9"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tsconfig/node24": "24.0.4",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@unicode/unicode-15.0.0": "1.6.17",
    "@vercel/ncc": "0.44.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "gha-docgen": "2.0.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "regenerate": "1.4.2",
    "semantic-release": "25.0.8",
    "semantic-release-major-tag": "0.3.2",
    "ts-morph": "28.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/github",
      "semantic-release-major-tag"
    ]
  }
}
