{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortPackageJson": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": ["dist/", "pnpm-lock.yaml"]
}
